# Discord Bot Credentials
DISCORD_TOKEN=
CLIENT_ID=
OWNER=
DEV_MODE=false
LOG_CHANNEL=
PREFIX=!

# PostgreSQL Database (replaces Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional PG overrides:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# PGSSLMODE=no-verify
# DATABASE_SSL=false

# osu! v2 API (OAuth Client Credentials)
# Register at: https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Gas Notification Scheduler
GAS_NOTIFY_GUILD_ID=
GAS_NOTIFY_CHANNEL_ID=

# Google Search
GG_API_KEY=
CSE_ID=

# AI / Perplexity / Gemma (Optional)
PPLX_KEY=
# PPLX_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# PPLX_MODEL=models/gemma-4-31b-it

# nHentai (Optional)
# NH_API_KEY=
# NH_USER_TOKEN=

# Facebook Fixer (Optional)
# FB_COOKIES=

# Cloudflare (Optional)
# CLOUDFLARE_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_NAMESPACE_ID=
